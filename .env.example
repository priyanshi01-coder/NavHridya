# ---------------------------------------------------------------------------
# Pick ONE provider. Both speak the same API, so nothing else changes.
# ---------------------------------------------------------------------------

# Option A — OpenAI (needs credits on the account)
AI_PROVIDER=openai
OPENAI_API_KEY=

# Option B — Groq (free tier; whisper-large-v3 + Llama)
#   Get a key at https://console.groq.com/keys
# AI_PROVIDER=groq
# GROQ_API_KEY=

# Leave both keys empty to run the offline demo path
# (pasted transcript + local lexicon analyser).

# Override the models only if your provider retires one.
# ASR_MODEL=
# NLP_MODEL=
# AI_BASE_URL=

# ---------------------------------------------------------------------------
# Live Call (the third input mode, alongside upload and paste)
# ---------------------------------------------------------------------------
# Live transcription works with the key you already have above: the browser
# sends a few seconds of speech at a time and Whisper transcribes each clip.
#
# Set a Deepgram key to unlock true streaming instead - audio goes out
# continuously and text comes back in under a second. Get one free at
# https://console.deepgram.com/  ($200 of credit, no card).
# The streaming path also needs:  pip install websockets
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-2

# How often the model may re-read a call in progress, in seconds. The
# deterministic safety rules run on every word regardless of this.
# NAVHRIDYA_LIVE_INTERVAL=12

# true -> transcribe with local faster-whisper instead of any API
USE_LOCAL_WHISPER=false
LOCAL_WHISPER_MODEL=medium

# Signs the session tokens. Generated automatically if unset.
NAVHRIDYA_SECRET=

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# The console starts empty - nothing exists until a call is uploaded.
# Set this to true to pre-score the five bundled sample transcripts on a fresh
# database instead, which is handy right before a demo.
SEED_DEMO_CASES=false
